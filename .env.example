# Rename this file to .env and fill in your keys.

# LLM provider: ollama | anthropic | openai | openai-compatible
LLM_PROVIDER=ollama

# Free local configuration (recommended): Ollama
# 1) Install Ollama: https://ollama.com/download
# 2) Pull a model: ollama pull llama3.1:8b
# 3) Run Ollama (default URL below)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / OpenAI-compatible configuration
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
OPENAI_MODEL=gpt-4.1-mini
# Optional: set for compatible providers (OpenRouter, Groq, local gateways, etc.)
OPENAI_BASE_URL=

PORT=3000
